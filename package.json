{
  "name": "when-working-javascript-breaks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser demos of working JavaScript failing under security constraints",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "scan": "node semgrep.js scan --config .semgrep.yml --metrics off --error demos",
    "scan:registry": "node semgrep.js scan --config p/javascript --config p/xss --config p/default --metrics off demos",
    "start": "node server.js",
    "stop": "node stop.js",
    "dev": "node --watch --watch-preserve-output server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "demo:csp": "playwright test --config demos/tests/playwright.config.js profile.spec.js",
    "demo:coop": "playwright test --config demos/tests/playwright.config.js coop.spec.js",
    "demo:reports": "node reporting-demo.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
