{
  "name": "when-working-javascript-breaks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser demos of working JavaScript failing under security constraints",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "webpack --config webpack.config.js",
    "start": "npm run build && node server.js",
    "serve": "node server.js",
    "dev": "npm run build && concurrently --kill-others --names server,bundle \"npm:watch:server\" \"npm:watch:bundle\"",
    "watch:server": "node --watch --watch-preserve-output server.js",
    "watch:bundle": "webpack --config webpack.config.js --watch",
    "test": "npm run build && node --test test/*.test.js",
    "test:browser": "playwright test",
    "demo:csp": "playwright test --config demos/tests/playwright.config.js profile.spec.js",
    "demo:coop": "playwright test --config demos/tests/playwright.config.js coop.spec.js",
    "demo:reports": "node reporting-demo.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "webpack": "^5.0.0",
    "webpack-cli": "^6.0.0"
  }
}
