{
  "name": "when-working-javascript-breaks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser demos of working JavaScript failing under security constraints",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "scan": "npm run scan --workspaces --if-present",
    "scan:registry": "node demos/common/semgrep.js scan --config p/javascript --config p/xss --config p/default --metrics off demos",
    "stop": "node demos/common/stop.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "workspaces": [
    "demos/summary",
    "demos/widget",
    "demos/fractal",
    "demos/coop",
    "demos/broadcast",
    "demos/embed",
    "demos/profile",
    "demos/reporting"
  ]
}
